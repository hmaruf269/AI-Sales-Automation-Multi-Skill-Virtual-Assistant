# Generate unique values; never commit the real .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
HERMES_API_SERVER_KEY=replace-with-at-least-32-random-characters
SECRET_ENCRYPTION_KEY=replace-with-a-fernet-key

OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-at-least-12-characters
PUBLIC_BASE_URL=http://localhost:3000
COOKIE_SECURE=false

# Free option: a Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# Leave blank to keep Gemini disabled. Hermes reads this key; the app only sees the flag.
GEMINI_API_KEY=
GEMINI_CONFIGURED=false
# Seeded as the default route when Gemini is enabled.
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite

# Set true only after the corresponding provider is configured inside the Hermes profile.
OPENAI_CONFIGURED=false
KIMI_CONFIGURED=false
