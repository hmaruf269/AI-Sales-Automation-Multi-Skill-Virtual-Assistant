# Server-side only: where the Next.js server proxies /api/* requests. Not exposed to the browser.
BACKEND_URL=http://localhost:8000

# live (default): use the backend; if it is unreachable the app offers an explicitly labelled Demo Mode.
# demo: always run the self-contained demo with sample data (no backend needed, nothing is ever sent).
NEXT_PUBLIC_DATA_MODE=live
